# DATABASE_PATH: (Recommended for production on Hostinger / cloud deployment)
# Set to a permanent directory path outside the git checkout folder to ensure git pulls never overwrite your data.
# Example: DATABASE_PATH="/home/u123456789/pakservices_data/pakservices.db"
# If not set, defaults to "pakservices.db" in the application root.
DATABASE_PATH=""

# DISABLE_SEED: Set to "true" in production to permanently disable any demo data seeding.
DISABLE_SEED="false"

